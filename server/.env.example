# PostgreSQL connection string
# Local example: postgresql://postgres:password@localhost:5432/workout_tracker
# Or use a free hosted Postgres from Supabase/Neon/Railway
DATABASE_URL="postgresql://user:password@localhost:5432/workout_tracker"

# Used to sign JWTs — generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Free API key: https://fdc.nal.gov/api-key-signup
USDA_API_KEY="your-usda-api-key"

# Anthropic API key for the AI chat feature: https://console.anthropic.com
ANTHROPIC_API_KEY="your-anthropic-api-key"

PORT=4000
CLIENT_URL="http://localhost:5173"
